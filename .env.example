# Žiadna premenná nemá prefix NEXT_PUBLIC_ — appka číta Supabase aj push výhradne
# na serveri, takže sa do prehliadača nedostane ani jedna hodnota. Na Verceli sa
# preto všetky dajú uložiť ako Secret.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Vývojový náhľad bez Supabase. V produkcii nechaj vypnuté alebo nastav na false.
# Na hostingu appka s hodnotou true zámerne odmietne štart — náhľad zapisuje do
# súboru, ktorý sa na Verceli zahadzuje, a dáta klubu by ticho mizli.
DEMO_MODE=false

# Web Push (VAPID). Vygeneruj vlastnú dvojicu:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Verejný kľúč posiela server do stránky, privátny musí zostať tajný.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:klub@example.sk

# Tajný token pre /api/notifikacie/splatnost, aby upomienky nevedel spustiť ktokoľvek.
# Na Vercele stačí namiesto tejto premennej nastaviť CRON_SECRET — Vercel Cron ho
# posiela v hlavičke sám. Endpoint uznáva obe mená, netreba ich duplikovať.
NOTIFICATION_CRON_SECRET=

# Service-role kľúč Supabase. Používa ho VÝLUČNE naplánovaná úloha s upozorneniami,
# ktorá beží bez prihláseného používateľa. Obchádza RLS, takže patrí len na server —
# nikdy nie do prehliadača a nikdy nie do gitu. Bez neho cron notifikácie nefungujú.
SUPABASE_SERVICE_ROLE_KEY=
